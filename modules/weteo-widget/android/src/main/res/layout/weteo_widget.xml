<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/weteo_widget"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/weteo_widget_background"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:padding="8dp">

  <ImageView
    android:id="@+id/weteo_widget_icon"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:layout_marginStart="4dp"
    android:importantForAccessibility="no"
    android:scaleType="fitCenter"
    android:src="@drawable/weteo_widget_partly_sunny" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingStart="8dp">

    <TextView
      android:id="@+id/weteo_widget_temperature"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="—"
      android:textColor="#FFFFFF"
      android:textSize="24sp" />

    <TextView
      android:id="@+id/weteo_widget_place"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#FFFFFF"
      android:textSize="14sp" />
  </LinearLayout>
</LinearLayout>
